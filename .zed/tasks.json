[
  {
    "label": "Build lily_conductor",
    "command": "cargo",
    "args": [
      "build",
      "--manifest-path",
      "lily_conductor/Cargo.toml"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
